# CareSync Frontend Environment Template
# Copy this file to frontend/.env and configure your Google Maps JavaScript API key.
# In Google Cloud Console, restrict this key:
#   1. Application restrictions -> Websites / HTTP referrers:
#      - http://localhost:5173/*
#      - http://127.0.0.1:5173/*
#   2. API restrictions -> Restrict key to:
#      - Maps JavaScript API
# NEVER commit frontend/.env containing your real API key to Git.

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_javascript_api_key_here
