# CareSync Application Environment Configuration Example

# Backend Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caresync
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS & Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Mail / SMTP Configuration
# Email delivery is disabled by default (MAIL_ENABLED=false)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=noreply@caresync.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# For local development with MailHog / Inbucket:
# MAIL_ENABLED=true
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=noreply@caresync.com
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS_ENABLE=false

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8080/api

# Automated Appointment Reminder Scheduler Configuration
SCHEDULER_TIMEZONE=Asia/Kolkata
REMINDER_SCHEDULER_ENABLED=true
REMINDER_INTERVAL_MS=60000
REMINDER_INITIAL_DELAY_MS=10000
REMINDER_CRON=0 0 8 * * *

# Google OAuth2 Configuration (Phase 3)
# Leave empty to keep Google OAuth login disabled
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback
FRONTEND_LOGIN_URI=http://localhost:5173/login


