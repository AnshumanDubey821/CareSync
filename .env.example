# CareSync Healthcare & Doctor Appointment Scheduler
# Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE YOUR LOCAL VALUES.
# NEVER COMMIT ACTUAL KEYS OR SECRETS TO VERSION CONTROL.

# Database Configuration (Docker / Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=caresync
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Server & Client Configuration
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & JWT Authentication
JWT_SECRET=replace_with_a_secure_base64_secret_at_least_256_bits_length
JWT_EXPIRATION=86400000

# Google OAuth2 Login
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Google Places API (New) Configuration
# Supply your Google Places API Key here or in local PowerShell via $env:GOOGLE_PLACES_API_KEY="..."
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Rate Limits for Google Places Proxy (Requests per minute)
GOOGLE_PLACES_RATE_LIMIT_PER_USER=10
GOOGLE_PLACES_RATE_LIMIT_PER_IP=30
GOOGLE_PLACES_RATE_LIMIT_PHOTO=5

# Monthly Persistent Usage Guard & Cost Protection Limits
GOOGLE_PLACES_MONTHLY_WARNING_LIMIT=68000
GOOGLE_PLACES_MONTHLY_HARD_LIMIT=69000

# Trusted Proxies (Comma-separated IP addresses that may set X-Forwarded-For; leave empty if direct)
GOOGLE_PLACES_TRUSTED_PROXIES=

# Email Notifications (Phase 1 & Phase 2)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@caresync.com
